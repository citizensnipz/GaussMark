{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2022", "DOM"],
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["./**/*.ts", "../src/core/community.ts", "../src/core/types.ts"]
}
